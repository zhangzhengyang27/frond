{
  "id": "com.frond.lorem",
  "name": "Lorem Ipsum",
  "version": "1.0.1",
  "description": "生成占位文本：单词/句子/段落，支持自定义数量，经典 Lorem Ipsum 文本，一键复制",
  "author": "Frond",
  "main": "index.html",
  "commands": [
    {
      "code": "generate",
      "title": "生成占位文本",
      "description": "生成 Lorem Ipsum 占位文本"
    }
  ],
  "preferences": [
    {
      "name": "unit",
      "label": "生成单位",
      "type": "select",
      "default": "paragraph",
      "options": ["word", "sentence", "paragraph"]
    },
    {
      "name": "count",
      "label": "生成数量",
      "type": "select",
      "default": "3",
      "options": ["1", "3", "5", "10"]
    }
  ],
  "permissions": []
}
