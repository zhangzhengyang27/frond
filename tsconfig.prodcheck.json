{
  // Leaf · 生产代码专用 typecheck 配置（配套脚本 pnpm typecheck:prodcheck）
  //
  // 为什么要有它：tsc 在程序里存在语法错的文件时只报语法诊断、不上语义诊断。恢复期有
  // 9 个 __tests__ 文件是断头/带占位的残件（TS1005 一大片），于是 `pnpm typecheck:node`
  // 会「只有语法错、零语义错」，把 141 条真实的类型/导出/重名问题全掩盖掉。
  // 排掉这些测试文件后语义层才会跑起来——本配置就是用来拿那份真清单的。
  // 它不替代 typecheck:node：等测试件重写完成，那个才是完整闸口。
  "extends": "./tsconfig.node.json",
  "compilerOptions": { "composite": false, "incremental": false, "noEmit": true },
  "include": ["electron.vite.config.*", "src/main/**/*.ts", "src/preload/**/*.ts", "src/shared/**/*"],
  "exclude": ["src/**/__tests__/**"]
}
